@startuml Container_Diagram_Full_Infrastructure
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(passenger, "Пассажир", "Заказывает поездки")
Person(driver, "Водитель", "Принимает заказы и получает выплаты")
Person(manager, "Корпоративный менеджер", "Управляет счетами")
Person(accountant, "Бухгалтер", "Контролирует выплаты")
Person(dev_engineer, "Разработчик", "Разрабатывает новые функции")
Person(sre_engineer, "SRE инженер", "Мониторит и поддерживает систему")

System_Boundary(go_future_system, "GoFuture Platform") {
    ' ### КЛИЕНТСКИЕ ПРИЛОЖЕНИЯ ###
    Container(web_passenger, "Пассажирское приложение", "iOS/Android/Huawei", "Интерфейс для пассажиров")
    Container(web_driver, "Водительское приложение", "iOS/Android/Huawei", "Интерфейс для водителей")
    Container(web_portal, "Корпоративный веб-портал", "Web Application (JS/React)", "Управление заказами")
    Container(admin_portal, "Админ-панель", "Web Application (JS/React)", "Управление выплатами")

    ' ### Общий брокер для всех задач ###
    ContainerQueue(KafkaBroker, "Брокер сообщений с разными топиками для сервисов", "Kafka", "Брокер сообщений, в том числе для фоновых задач сервисов")

    ' ### GraphQL сервис ###
    Container(GraphQL, "GraphQL сервис для объединения запросов", "JavaScript", "Формирует ответ от ендпоинтов в зависимости от запрашиваемого варианта")
    
    ' ### Микросервисы ###
    Container_Boundary(Booking, "Booking service"){
      Container(BookingBackend, "Booking Backend", "FastAPI", "Backend сервис на REST API")
      ContainerDb(BookingDB, "Booking DB", "PostgreSQL RDS", "База данных сервиса")
      ContainerDb(BookingCache, "In-memory кэш", "Redis", "Кэширование данных")
      ContainerDb(DriverSearch, "Поисковый индекс", "Elasticsearch", "Геопоиск водителей")
      Container(BookingWorker, "Воркеры фоновых задач", "Celery", "Обработка асинхронных задач")
      Rel(BookingBackend, KafkaBroker, "Отправка задач")
      Rel(BookingWorker, KafkaBroker, "Получает задачи из", "AMQP")
      Rel(BookingWorker, BookingDB, "Чтение/запись данных", "ORM")
      Rel(BookingWorker, BookingDB, "Сохраняет результаты", "ORM")
      Rel(BookingBackend, BookingCache, "Кешировние данных")
      Rel(BookingBackend, BookingDB, "Чтение/запись (ORM)")
    }

    Container_Boundary(Driver, "Driver service"){
      Container(DriverBackend, "Driver Backend", "FastAPI", "Backend сервис на REST API")
      ContainerDb(DriverDB, "Driver DB", "PostgreSQL RDS", "База данных сервиса")
      ContainerDb(DriverCache, "In-memory кэш", "Redis", "Кэширование данных")
      ContainerDb(DriverSearch, "Поисковый индекс", "Elasticsearch", "Геопоиск водителей")
      Container(DriverWorker, "Воркеры фоновых задач", "Celery", "Обработка асинхронных задач")
      Rel(DriverBackend, KafkaBroker, "Отправка задач")
      Rel(DriverWorker, KafkaBroker, "Получает задачи из", "AMQP")
      Rel(DriverWorker, DriverDB, "Чтение/запись данных", "ORM")
      Rel(DriverWorker, DriverDB, "Сохраняет результаты", "ORM")
      Rel(DriverBackend, DriverSearch, "Геопоиск водителей")
      Rel(DriverBackend, DriverCache, "Кешировние данных")
      Rel(DriverBackend, DriverDB, "Чтение/запись (ORM)")
    }

    Container_Boundary(Pricing, "Pricing service"){
      Container(PricingBackend, "Pricing Backend", "FastAPI", "Backend сервис на REST API")
      ContainerDb(PricingDB, "Pricing DB", "PostgreSQL RDS", "База данных сервиса")
      ContainerDb(PricingCache, "In-memory кэш", "Redis", "Кэширование данных")
      Container(PricingWorker, "Воркеры фоновых задач", "Celery", "Обработка асинхронных задач")
      Rel(PricingBackend, KafkaBroker, "Отправка задач")
      Rel(PricingWorker, KafkaBroker, "Получает задачи из", "AMQP")
      Rel(PricingWorker, PricingDB, "Чтение/запись данных", "ORM")
      Rel(PricingWorker, PricingDB, "Сохраняет результаты", "ORM")
      Rel(PricingBackend, PricingCache, "Кешировние данных")
      Rel(PricingBackend, PricingDB, "Чтение/запись (ORM)")
    }

    Container_Boundary(Payments, "Payments service"){
      Container(PaymentsBackend, "Payments Backend", "FastAPI", "Backend сервис на REST API")
      ContainerDb(PaymentsDB, "Payments DB", "PostgreSQL RDS", "База данных сервиса")
      ContainerDb(PaymentsCache, "In-memory кэш", "Redis", "Кэширование данных")
      Container(PaymentsWorker, "Воркеры фоновых задач", "Celery", "Обработка асинхронных задач")
      Rel(PaymentsBackend, KafkaBroker, "Отправка задач")
      Rel(KafkaBroker, PaymentsBackend, "Чтение топика задач")
      Rel(PaymentsBackend, KafkaBroker, "Отправка результата по задаче")
      Rel(PaymentsWorker, KafkaBroker, "Получает задачи из", "AMQP")
      Rel(PaymentsWorker, PaymentsDB, "Чтение/запись данных", "ORM")
      Rel(PaymentsWorker, PaymentsDB, "Сохраняет результаты", "ORM")
      Rel(PaymentsBackend, PaymentsCache, "Кешировние данных")
      Rel(PaymentsBackend, PaymentsDB, "Чтение/запись (ORM)")
    }

    Container_Boundary(Notification, "Notification service"){
      Container(NotificationBackend, "Notification Backend", "FastAPI", "Backend сервис на REST API")
      ContainerDb(NotificationDB, "Notification DB", "PostgreSQL RDS", "База данных сервиса")
      ContainerDb(NotificationCache, "In-memory кэш", "Redis", "Кэширование данных")
      Container(NotificationWorker, "Воркеры фоновых задач", "Celery", "Обработка асинхронных задач")
      Rel(NotificationBackend, KafkaBroker, "Отправка задач")
      Rel(KafkaBroker, NotificationBackend, "Чтение топика задач")
      Rel(NotificationBackend, KafkaBroker, "Отправка результата по задаче")
      Rel(NotificationWorker, KafkaBroker, "Получает задачи из", "AMQP")
      Rel(NotificationWorker, NotificationDB, "Чтение/запись данных", "ORM")
      Rel(NotificationWorker, NotificationDB, "Сохраняет результаты", "ORM")
      Rel(NotificationBackend, NotificationCache, "Кешировние данных")
      Rel(NotificationBackend, NotificationDB, "Чтение/запись (ORM)")
    }

    Container_Boundary(Geography, "Geography service"){
      Container(GeographyBackend, "Geography Backend", "FastAPI", "Backend сервис на REST API")
      ContainerDb(GeographyDB, "Geography DB", "PostgreSQL RDS", "База данных сервиса")
      ContainerDb(GeographyCache, "In-memory кэш", "Redis", "Кэширование данных")
      Container(GeographyWorker, "Воркеры фоновых задач", "Celery", "Обработка асинхронных задач")
      Rel(GeographyBackend, KafkaBroker, "Отправка задач")
      Rel(GeographyWorker, KafkaBroker, "Получает задачи из", "AMQP")
      Rel(GeographyWorker, GeographyDB, "Чтение/запись данных", "ORM")
      Rel(GeographyWorker, GeographyDB, "Сохраняет результаты", "ORM")
      Rel(GeographyBackend, GeographyCache, "Кешировние данных")
      Rel(GeographyBackend, GeographyDB, "Чтение/запись (ORM)")
    }

    Container_Boundary(Fraud, "Fraud service"){
      Container(FraudBackend, "Fraud Backend", "FastAPI", "Backend сервис на REST API")
      ContainerDb(FraudDB, "Fraud DB", "PostgreSQL RDS", "База данных сервиса")
      ContainerDb(FraudCache, "In-memory кэш", "Redis", "Кэширование данных")
      Container(FraudWorker, "Воркеры фоновых задач", "Celery", "Обработка асинхронных задач")
      Rel(KafkaBroker, FraudBackend, "Чтение топика задач")
      Rel(FraudBackend, KafkaBroker, "Отправка результата по задаче")
      Rel(FraudWorker, KafkaBroker, "Получает задачи из", "AMQP")
      Rel(FraudWorker, FraudDB, "Чтение/запись данных", "ORM")
      Rel(FraudWorker, FraudDB, "Сохраняет результаты", "ORM")
      Rel(FraudBackend, FraudCache, "Кешировние данных")
      Rel(FraudBackend, FraudDB, "Чтение/запись (ORM)")
    }

    ' ### МОНИТОРИНГ И OBSERVABILITY ###
    Container(monitoring, "Prometheus", "Monitoring System", "Сбор метрик и мониторинг")
    Container(grafana, "Grafana", "Dashboard System", "Визуализация метрик и дашборды")
    Container(loki, "Loki", "Log Aggregation", "Сбор и анализ логов")
    Container(alert_manager, "Alertmanager", "Alert System", "Управление алертами")
    
    ' ### CI/CD ИНФРАСТРУКТУРА ###
    Container(jenkins, "Jenkins", "CI/CD Server", "Сборка и деплой монолита")
    Container(artifact_repo, "Artifact Repository", "Docker Registry", "Хранение образов приложения")
    Container(ci_worker, "CI/CD Workers", "VM/Containers", "Выполнение задач сборки и тестов")
    
    ' ### АНАЛИТИЧЕСКАЯ ИНФРАСТРУКТУРА ###
    Container(analytics_engine, "Analytics Engine", "Spark/Flink", "Обработка аналитических данных")
    Container(analytics_db, "Analytics DB", "ClickHouse", "Хранение аналитических данных")
    Container(datalens, "DataLens", "BI Tool", "Визуализация бизнес-метрик")
}

' ### ВНЕШНИЕ СИСТЕМЫ ###
System_Ext(yandex_pay, "Яндекс.Пэй", "Платежный шлюз")
System_Ext(yandex_maps, "Яндекс.Карты", "Картографический сервис")
