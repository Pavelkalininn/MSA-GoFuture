Rel(NotificationWorker, apns, "Отправляет уведомления", "REST API")
Rel(NotificationWorker, huawei_push, "Отправляет уведомления", "REST API")
Rel(PaymentsWorker, bank_api, "Выполняет выплаты", "REST API")

