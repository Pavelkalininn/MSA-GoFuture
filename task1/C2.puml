Rel(web_passenger, BookingBackend, "HTTP/REST API")
Rel(web_driver, DriverBackend, "HTTP/REST API")
Rel(web_portal, GraphQL, "HTTP/REST API")
Rel(admin_portal, GraphQL, "HTTP/REST API")


Rel(GraphQL, FraudBackend, "HTTP/REST API")
