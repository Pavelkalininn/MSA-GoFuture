Rel(BookingWorker, monitoring, "Отправляет метрики", "Prometheus Metrics")

Rel(BookingDB, monitoring, "Метрики БД", "PostgreSQL Exporter")
Rel(DriverDB, monitoring, "Метрики БД", "PostgreSQL Exporter")
Rel(PricingDB, monitoring, "Метрики БД", "PostgreSQL Exporter")
Rel(PaymentsDB, monitoring, "Метрики БД", "PostgreSQL Exporter")
Rel(NotificationDB, monitoring, "Метрики БД", "PostgreSQL Exporter")
